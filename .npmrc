virtual-store-dir-max-length=120
# pnpm/npm prepare needs to install devDependencies from package-lock.json,
# whose "resolved" URLs point at registry.npmmirror.com. npm >= 11 refuses
# "remote" (URL-specified) dependencies by default (allow-remote=none), which
# made every git/tarball install fail with EALLOWREMOTE during prepare.
allow-remote=all
